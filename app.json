{
  "expo": {
    "name": "Budget Vibes",
    "slug": "budget-vibes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF4E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetvibes.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF4E9"
      },
      "package": "com.budgetvibes.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Budget Vibes to access your photos for your profile picture."
        }
      ]
    ]
  }
}
